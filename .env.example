# Copy to .env for local development. The server gets the same names from
# GitHub secrets at deploy time; nothing here is ever committed.

# Where a browser reaches this service.
AUTH_URL=http://localhost:3001
PORT=3001

# Signs session cookies. Any long random string; locally: openssl rand -base64 32
BETTER_AUTH_SECRET=

DATABASE_URL=postgres://auth:auth@localhost:5433/auth

# Google Cloud → irmahs-hub → Google Auth Platform → Clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. Production: https://irmahs.dev,https://*.irmahs.dev
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Production only: irmahs.dev, so one sign-in covers every subdomain.
COOKIE_DOMAIN=
