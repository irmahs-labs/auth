{
  "name": "auth",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait db && docker compose run --rm migrate up",
    "db:new": "docker compose run --rm migrate new",
    "db:schema": "tsx --env-file=.env scripts/schema.ts",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.10",
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
